# Copy this file to .env and fill it in. .env is read automatically when the app
# starts from this folder, and it is ignored by git. Real environment variables win.

# The first administrator. Only used when the database has no users at all.
# With neither set, nobody is created. Set both or neither.
CASTTRAIL_ADMIN_EMAIL=
CASTTRAIL_ADMIN_PASSWORD=
CASTTRAIL_ADMIN_DISPLAY_NAME=Admin

# TMDB "API Read Access Token". Search and watching need it.
# CASTTRAIL_TMDB_READ_TOKEN=

# Contact Rostercon once a day for the people you watch, at this hour (0 to 23,
# server local time). The admin refresh page can run it by hand either way.
CASTTRAIL_REFRESH_ENABLED=false
CASTTRAIL_REFRESH_HOUR=4

# Where the database lives, and how long sign-ins last.
# CASTTRAIL_DATABASE_URL=sqlite+aiosqlite:///data/casttrail.db
# CASTTRAIL_SESSION_TTL_HOURS=720

# "auto" marks the sign-in cookie Secure when the request arrived over HTTPS.
# CASTTRAIL_COOKIE_SECURE=auto

# The interactive API docs are off unless set to true.
# CASTTRAIL_DOCS_ENABLED=false
